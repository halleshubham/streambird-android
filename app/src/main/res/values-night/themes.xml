<resources>
    <style name="Theme.StreamBird" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/sb_bg_dark</item>
    </style>
    <style name="Theme.StreamBird.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sb_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.StreamBird</item>
    </style>
</resources>
